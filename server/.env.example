# ---------- Server ----------
NODE_ENV=development
PORT=5000

# MongoDB connection string
#   Local:  mongodb://127.0.0.1:27017/orixa
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orixa?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/orixa

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed by CORS. Comma separate multiple URLs.
CLIENT_URL=http://localhost:5173

# Set to true to let Express serve client/dist (single-server deployment)
SERVE_CLIENT=false

# ---------- Store pricing ----------
CURRENCY=USD
FREE_SHIPPING_THRESHOLD=50
SHIPPING_FLAT_RATE=10
TAX_RATE=0.05

# ---------- Rate limiting (per IP, per window) ----------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000    # write requests per window; GET requests are allowed 6x this
AUTH_RATE_LIMIT_MAX=30

# ---------- Email (password reset). Leave empty in development: links are printed to the console ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ORiXA <no-reply@orixa.com>

# ---------- Seed / first admin (used by npm run seed and npm run create-admin) ----------
ADMIN_NAME=ORiXA Admin
ADMIN_EMAIL=admin@orixa.com
ADMIN_PASSWORD=

# ---------- Future integrations (not active yet) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
